# Biến môi trường khi deploy (Zeabur > Service > Variables). KHÔNG commit giá trị thật.
APP_ENV=production
# Zeabur tự cấp PORT, không cần đặt

# Domain Zeabur cấp cho service, ví dụ https://timetribe-api.zeabur.app
BASE_URL=https://<ten-mien>.zeabur.app

# MongoDB Atlas: Database > Connect > Drivers. Nhớ mở Network Access 0.0.0.0/0 (IP Zeabur thay đổi)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=timetribe

# Chuỗi ngẫu nhiên >= 32 ký tự, tạo bằng: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

# Nội dung file serviceAccountKey.json dạng base64 (một dòng):
#   base64 -w0 serviceAccountKey.json        (Linux)
#   base64 -i serviceAccountKey.json         (macOS)
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))   (PowerShell)
FIREBASE_CREDENTIALS_JSON=

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
RESET_PASSWORD_URL=https://timetribe.app/reset-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ENABLE_REMINDER=true

# Link file APK mới nhất (GitHub Releases, Google Drive...). Trang chủ "/" có nút tải trỏ về /download
APK_URL=
