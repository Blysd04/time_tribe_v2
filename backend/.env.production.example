# Biến môi trường khi deploy lên Render (Dashboard > timetribe-api > Environment).
# KHÔNG commit giá trị thật. Xem docs/DEPLOY.md mục "Lập các key".

# PORT và RENDER_EXTERNAL_URL do Render tự cấp, không cần đặt.
# BASE_URL chỉ cần khi dùng tên miền riêng, VD https://api.timetribe.app
# BASE_URL=

# MongoDB Atlas: Database > Connect > Drivers. Network Access phải mở 0.0.0.0/0 (IP Render thay đổi)
APP_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=TimeTribe
DB_NAME=timetribe
# Render tự sinh nếu tạo bằng render.yaml. Tự tạo: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

# Nội dung serviceAccountKey.json mã hoá base64 (một dòng), xem docs/DEPLOY.md
FIREBASE_CREDENTIALS_JSON=

CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Để trống: dùng trang đặt lại mật khẩu của backend (<BASE_URL>/reset-password)
RESET_PASSWORD_URL=

# Gửi email (quên mật khẩu, xác nhận đổi email). Chọn MỘT trong hai cách:
# Cách 1 (bắt buộc khi chạy trên Render gói Free, vì gói này chặn cổng SMTP): Brevo HTTP API.
#   BREVO_API_KEY lấy ở Brevo > SMTP & API > API Keys; SMTP_FROM là email người gửi đã xác minh trên Brevo.
BREVO_API_KEY=
MAIL_FROM_NAME=TimeTribe
SMTP_FROM=
# Cách 2 (máy chủ cho phép cổng SMTP): Gmail smtp.gmail.com cổng 587, SMTP_PASS là Mật khẩu ứng dụng 16 ký tự
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ENABLE_REMINDER=true

# Nút "Tải APK" gọi /download, server gửi thẳng file APK trong response (không chuyển hướng).
# Cách 1: để file ở backend/public/timetribe.apk, build Docker sẽ chép vào image. Đổi chỗ thì đặt APK_PATH.
APK_PATH=public/timetribe.apk
# Cách 2: không có file trên server thì server tải từ link này rồi chuyển tiếp cho người dùng
APK_URL=
