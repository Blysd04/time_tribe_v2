APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080

MONGO_URI=mongodb://localhost:27017
DB_NAME=timetribe

# Chuỗi bí mật ký JWT, đổi thành chuỗi dài ngẫu nhiên khi deploy
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30

# File service account tải từ Firebase Console > Project settings > Service accounts
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Dạng cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

SHARE_BASE_URL=https://timetribe.app
RESET_PASSWORD_URL=https://timetribe.app/reset-password

# Để trống thì email quên mật khẩu chỉ in ra log, API trả kèm debug_reset_token để test
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

ENABLE_REMINDER=true
